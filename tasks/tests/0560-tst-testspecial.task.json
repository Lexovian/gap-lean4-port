    {
      "path": "tst/testspecial/syntax-err-eof-sentinel.g",
      "language": "g",
      "source_raw_url": "https://raw.githubusercontent.com/gap-system/gap/master/tst/testspecial/syntax-err-eof-sentinel.g",
      "source_view_url": "https://github.com/gap-system/gap/blob/master/tst/testspecial/syntax-err-eof-sentinel.g",
      "suggested_lean_module": "RequestProject.Gap.Tests.Testspecial.SyntaxErrEofSentinel",
      "code_lines": 18,
      "definitions": 0,
      "effort_person_days": 0.18,
      "header_quote": "Regression test for a 0xFF byte leak in syntax-error context lines.\n\nWhen a syntax error fires after the scanner has advanced past EOF\n(e.g. parsing \"h := ;\" via READ_ALL_COMMANDS from a string with no\ntrailing newline), the input-line buffer is replaced with the\nscanner's end-of-input sentinel (0xFF). Before the fix in\nsrc/scanner.c the SyntaxErrorOrWarning() pretty-printer would dump\nthat sentinel verbatim alongside the error message — visible as a\nstray `ÿ` glyph in any UTF-8 / log-file consumer of *errout*\n(e.g. the JupyterKernel package)."
    },
