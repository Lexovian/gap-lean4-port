      "suggested_lean_module": "RequestProject.Gap.Tests.Testbugfix.20180321IsFinitelyGeneratedGroup",
      "code_lines": 6,
      "definitions": 0,
      "effort_person_days": 0.06,
      "header_quote": "There was an incorrect method for IsFinitelyGeneratedGroup which assumed\nthat a group given by an infinite generating set is not finitely generated,\nwhich is of course false: any finitely generated infinite group is generated\nby its set of elements.\n\nTest that this is not the case anymore:"
    },
